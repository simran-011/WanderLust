<% layout("./layouts/boilerplate") %>
<script>
           const mapToken = "<%= process.env.MAP_TOKEN %>"; 
           const coordinates = <%- JSON.stringify(allInfo.geometry.coordinates) %> 
                </script>
    <body>

        <div class="row ">
            <div class="col-8 offset-2 mt-3">
                <h3>
                    <%= allInfo.title%>
                </h3>
            </div>
            <div class="card col-6 offset-2">
                <img src="<%= allInfo.image.url %>" class="card-img-top showImg" alt="...">
                <div class="card-body">

                    <p class="card-text">
                        <b>Owned By:</b>
                        <i>
                            <%= allInfo.owner.username %>
                        </i>
                    </p>
                    <p class="card-text">
                        <%= allInfo.description%> <br> <br>
                    </p>
                    <p class="card-text">
                        <%= allInfo.description%> <br> <br>
                    </p>
                    <p class="card-text">&#8377;<%= allInfo.price.toLocaleString("en-IN")%> <br> <br> </p>
                    <p class="card-text">
                        <%= allInfo.location%> <br> <br>
                    </p>
                    <p class="card-text">
                        <%= allInfo.country%> <br> <br>
                    </p>

                    </p>
                </div>
            </div>



        </div>
        <% if(currUser && currUser._id.equals(allInfo.owner._id)) { %>


            <div class="btns">
                <form method="GET" action="/listings/<%= allInfo._id %>/edit">
                    <button class="btn btn-danger editBtn  ">Edit </button>
                </form>


                <form method="POST" action="/listings/<%= allInfo._id %>?_method=DELETE">
                    <button class="btn btn-dark deleteBtn ">Delete </button>
                </form>
            </div>
            <% } %>
                <hr>
                <div class="col-8 offset-2">
                    <% if(currUser ) { %>
                        <h4>Leave a review</h4>
                        <form action="/listings/<%= allInfo._id %>/reviews" method="POST" class="needs-validation"
                            novalidate>
                            <!-- <div>
                                <label for="rating"  >Rating</label>
                                <input type="range" min="1" max="5" name="review[rating]" class="form-range">
                            </div> -->
                            <div>
                                <label for="rating">Rating</label>
                                <fieldset class="starability-slot">

                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                        value="1" checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>
                            <div>
                                <label for="comment" class="form-label">Comments</label>
                                <textarea name="review[comment]" id="comment" cols="30" rows="6"
                                    class="form-control mt-3" required></textarea>
                                <div class="invalid-feedback">please add a comment for review</div>
                            </div>
                            <button class="mt-3 mb-3 btn btn-outline-dark">Submit</button>
                        </form>
                        <hr>
                        <% } %>
                            <% if(allInfo.reviews.length>0) { %>


                                <h4>All Reviews</h4>
                                <div class="row">
                                    <% for(let review of allInfo.reviews) { %>
                                        <div class="card col-5 ms-3 mt-3 mb-3">
                                            <div class="card-body">
                                                <h5 class="card-title">@<%= review.author.username %>
                                                </h5>
                                                <p class="card-text">
                                                    <%= review.comment %>
                                                </p>
                                                <!-- <p class="card-text">
                                                <%= review.rating %>
                                            </p> -->

                                                <p class="starability-result" data-rating="<%= review.rating %>">

                                                </p>
                                                <form method="POST"
                                                    action="/listings/<%= allInfo._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                    <button class="btn btn-dark btn-sm mb-3">Delete</button>
                                                </form>
                                            </div>

                                        </div>
                                        <% } %>
                                </div>
                                <% } %>
                                    <div class="offset-1 col-6 mb-3"  >
                                        <h3>Where you'll be</h3>
                                        <div id="map"></div>
                                    </div>



                </div>

                <script src="/js/map.js"></script>









    </body>