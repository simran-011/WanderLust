<% layout("./layouts/boilerplate")%>
<body>

        <form method="POST" action="/listings/<%= allInfo._id%>?_method=PUT" class="needs-validation"  novalidate enctype="multipart/form-data">
            <div class="row col-8 " >

        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
           <input name="listings[title]" value="<%= allInfo.title %>" type="text" class="form-control" required>
           <div class="valid-feedback">
                Looks good!
            </div>
        </div>


        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
           <input name="listings[description]" value="<%= allInfo.description %>" type="text" class="form-control" required>
           <div class="invalid-feedback">
        provide a valid description.
      </div>
      <br>
      Original Listing Image
        </div>
        
        <% if (allInfo.image && allInfo.image.url) { %>
  <img src="<%=originalUrl %>" class="img-fluid"  style="max-height: 200px;  width: 350px">
<% } else { %>
  <p>No image available</p>
<% } %>
        <div class="mb-3">
            <label for="image" class="form-label">Image</label>
           <input name="image" type="file" class="form-control" >
           <div class="invalid-feedback">
        provide a valid image.
      </div>
        </div>

        <div class="mb-3">
            <label for="price" class="form-label">Price</label>
           <input name="listings[price]" value="<%= allInfo.price%>" type="text" class="form-control" required>
           <div class="invalid-feedback">
        provide a valid price.
      </div>
        </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
           <input name="listings[location]" value="<%= allInfo.location%>" type="text" class="form-control" required>
           <div class="invalid-feedback">
        provide a valid location.
      </div>
        </div>

       <div class="mb-3">
            <label for="country" class="form-label">Country</label>
           <input name="listings[country]" value="<%= allInfo.country%>" type="text" class="form-control" required>
           <div class="invalid-feedback">
        provide a valid country.
      </div>
        </div>

       <button class="btn btn-danger">Edit</button>
    </form>
    </div>
</body>